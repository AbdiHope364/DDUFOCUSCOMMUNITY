// DDU FOCUS Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  FOCUS_COORDINATOR
  SECTION_LEADER
  EVENT_MANAGER
  CONTENT_MANAGER
  MEDIA_MANAGER
  STUDENT
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  ALUMNI
  INACTIVE
  SUSPENDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  WITHDRAWN
}

enum MemberRole {
  MEMBER
  ASSISTANT_LEADER
  LEADER
}

enum AudienceType {
  PUBLIC
  MEMBERS_ONLY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PrayerVisibility {
  LEADERS_ONLY
  PRAYER_TEAM
  ANONYMOUS_COMMUNITY
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ResourceCategory {
  BIBLE_STUDY
  SERMON
  WORSHIP
  BOOK
  DISCIPLESHIP
  DOCUMENT
}

model AcademicYear {
  id         String    @id @default(uuid())
  yearLabel  String    @unique @map("year_label") // e.g. "2026/2027"
  isCurrent  Boolean   @default(false) @map("is_current")
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")
  students   Student[]

  @@map("academic_years")
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String         @map("password_hash")
  role            UserRole       @default(STUDENT)
  isEmailVerified Boolean        @default(false) @map("is_email_verified")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  student         Student?
  authoredWords   DailyWord[]
  createdEvents   Event[]
  announcements   Announcement[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Student {
  id               String         @id @default(uuid())
  userId           String         @unique @map("user_id")
  firstName        String         @map("first_name")
  lastName         String         @map("last_name")
  studentIdNumber  String         @unique @map("student_id_number")
  department       String
  yearLevel        Int            @map("year_level")
  phoneNumber      String?        @map("phone_number")
  avatarUrl        String?        @map("avatar_url")
  bio              String?
  status           StudentStatus  @default(ACTIVE)
  academicYearId   String?        @map("academic_year_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear?  @relation(fields: [academicYearId], references: [id])
  
  leadershipTerms  SectionLeader[]
  applications     SectionApplication[]
  reviewedApps     SectionApplication[] @relation("ReviewerRelation")
  memberships      SectionMember[]
  registrations    EventRegistration[]
  attendances      EventAttendance[]
  volunteerLogs    VolunteerLog[]
  verifiedLogs     VolunteerLog[]        @relation("VolunteerVerifier")
  prayerRequests   PrayerRequest[]

  @@map("students")
}

model Section {
  id              String                @id @default(uuid())
  name            String                @unique
  slug            String                @unique
  description     String
  icon            String                @default("Users")
  coverImageUrl   String?               @map("cover_image_url")
  meetingSchedule String?               @map("meeting_schedule")
  meetingLocation String?               @map("meeting_location")
  maxMembers      Int                   @default(100) @map("max_members")
  status          ContentStatus         @default(PUBLISHED)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  leaders         SectionLeader[]
  members         SectionMember[]
  applications    SectionApplication[]
  events          Event[]
  resources       Resource[]
  announcements   Announcement[]
  volunteerLogs   VolunteerLog[]

  @@map("sections")
}

model SectionLeader {
  id          String    @id @default(uuid())
  sectionId   String    @map("section_id")
  studentId   String    @map("student_id")
  title       String    @default("Section Leader")
  termStart   DateTime  @map("term_start") @db.Date
  termEnd     DateTime? @map("term_end") @db.Date
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  section     Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sectionId, studentId, termStart])
  @@map("section_leaders")
}

model SectionApplication {
  id               String            @id @default(uuid())
  sectionId        String            @map("section_id")
  studentId        String            @map("student_id")
  motivation       String
  skillsExperience String?           @map("skills_experience")
  experienceLevel  String            @default("BEGINNER") @map("experience_level")
  availabilityDays Json              @default("[]") @map("availability_days")
  status           ApplicationStatus @default(PENDING)
  reviewerId       String?           @map("reviewer_id")
  reviewNotes      String?           @map("review_notes")
  reviewedAt       DateTime?         @map("reviewed_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  section          Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer         Student?          @relation("ReviewerRelation", fields: [reviewerId], references: [id])

  @@map("section_applications")
}

model SectionMember {
  id        String     @id @default(uuid())
  sectionId String     @map("section_id")
  studentId String     @map("student_id")
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now()) @map("joined_at")
  isActive  Boolean    @default(true) @map("is_active")

  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sectionId, studentId])
  @@map("section_members")
}

model Event {
  id          String              @id @default(uuid())
  sectionId   String?             @map("section_id")
  title       String
  slug        String              @unique
  description String
  venue       String
  speakerName String?             @map("speaker_name")
  posterUrl   String?             @map("poster_url")
  startTime   DateTime            @map("start_time")
  endTime     DateTime            @map("end_time")
  audience    AudienceType        @default(PUBLIC)
  capacity    Int?
  status      ContentStatus       @default(PUBLISHED)
  createdById String?             @map("created_by")
  createdAt   DateTime            @default(now()) @map("created_at")

  section       Section?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  creator       User?             @relation(fields: [createdById], references: [id])
  registrations EventRegistration[]
  attendances   EventAttendance[]

  @@map("events")
}

model EventRegistration {
  id           String    @id @default(uuid())
  eventId      String    @map("event_id")
  studentId    String    @map("student_id")
  registeredAt DateTime  @default(now()) @map("registered_at")

  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@map("event_registrations")
}

model EventAttendance {
  id         String           @id @default(uuid())
  eventId    String           @map("event_id")
  studentId  String           @map("student_id")
  scannedAt  DateTime         @default(now()) @map("scanned_at")
  status     AttendanceStatus @default(PRESENT)

  event      Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@map("event_attendances")
}

model DailyWord {
  id                 String        @id @default(uuid())
  publishDate        DateTime      @unique @map("publish_date") @db.Date
  title              String
  verseText          String        @map("verse_text")
  scriptureReference String        @map("scripture_reference")
  reflection         String
  prayer             String
  challenge          String?
  coverImageUrl      String?       @map("cover_image_url")
  status             ContentStatus @default(SCHEDULED)
  createdById        String?       @map("created_by")
  createdAt          DateTime      @default(now()) @map("created_at")

  creator            User?         @relation(fields: [createdById], references: [id])

  @@map("daily_words")
}

model PrayerRequest {
  id                String           @id @default(uuid())
  studentId         String?          @map("student_id")
  title             String
  requestBody       String           @map("request_body")
  visibility        PrayerVisibility @default(LEADERS_ONLY)
  isAnswered        Boolean          @default(false) @map("is_answered")
  answeredTestimony String?          @map("answered_testimony")
  prayedCount       Int              @default(0) @map("prayed_count")
  createdAt         DateTime         @default(now()) @map("created_at")

  student           Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@map("prayer_requests")
}

model VolunteerLog {
  id           String    @id @default(uuid())
  studentId    String    @map("student_id")
  sectionId    String?   @map("section_id")
  activityName String    @map("activity_name")
  hoursServed  Decimal   @map("hours_served") @db.Decimal(5, 2)
  serviceDate  DateTime  @map("service_date") @db.Date
  description  String?
  isVerified   Boolean   @default(false) @map("is_verified")
  verifiedById String?   @map("verified_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section      Section?  @relation(fields: [sectionId], references: [id])
  verifier     Student?  @relation("VolunteerVerifier", fields: [verifiedById], references: [id])

  @@map("volunteer_logs")
}

model Resource {
  id               String           @id @default(uuid())
  sectionId        String?          @map("section_id")
  title            String
  category         ResourceCategory
  speakerAuthor    String?          @map("speaker_author")
  fileUrl          String?          @map("file_url")
  externalMediaUrl String?          @map("external_media_url")
  fileSizeBytes    BigInt?          @map("file_size_bytes")
  description      String?
  createdAt        DateTime         @default(now()) @map("created_at")

  section          Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@map("resources")
}

model Announcement {
  id          String        @id @default(uuid())
  sectionId   String?       @map("section_id")
  title       String
  content     String
  priority    String        @default("NORMAL")
  expiresAt   DateTime?     @map("expires_at")
  createdById String?       @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")

  section     Section?      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  creator     User?         @relation(fields: [createdById], references: [id])

  @@map("announcements")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  actionUrl String?  @map("action_url")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

